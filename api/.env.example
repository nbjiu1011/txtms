# API environment (copy to api/.env or set as environment variables). Never commit real secrets.

# HTTP port of the API (reverse proxy: https://txtms-api.tagoplus.co.kr -> 127.0.0.1:4245)
SERVER_PORT=4245

# MariaDB 10.11
DB_URL=jdbc:mariadb://112.160.125.11:3306/txtms
DB_USERNAME=txtms
DB_PASSWORD=change-me

# Signing key for access tokens (at least 32 random bytes, base64)
JWT_SECRET=change-me

# Public web origin: invitation/reset links and the trusted origin of refresh calls
WEB_BASE_URL=https://txtms.tagoplus.co.kr
# Extra origins allowed to call the API directly (comma-separated)
CORS_ALLOWED_ORIGINS=https://txtms.tagoplus.co.kr
# Refresh cookie over HTTPS only
REFRESH_COOKIE_SECURE=true

# Integration tests (local MariaDB 10.11, see scripts/dev-mariadb.ps1)
TEST_DB_URL=jdbc:mariadb://127.0.0.1:3318/txtms_test
TEST_DB_USERNAME=txtms
TEST_DB_PASSWORD=change-me
