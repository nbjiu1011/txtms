# txtms — content of the GitLab File variable ENV_FILE (one per environment scope).
#
#   Settings > CI/CD > Variables > Add variable
#     Type: File   Key: ENV_FILE   Environment scope: development (dev server) / production
#
# Every key here is passed to the API container. Do not quote values; a `$` must be written `$$`.
# COMPOSE_PROJECT_NAME, API_PORT and WEB_PORT are added by the CI job — do not set them here.

# ── Database (MariaDB 10.11) ─────────────────────────────────
# Same host as the containers? jdbc:mariadb://host.docker.internal:3306/txtms
DB_URL=jdbc:mariadb://112.160.125.11:3306/txtms
DB_USERNAME=txtms
DB_PASSWORD=change-me

# ── Auth ─────────────────────────────────────────────────────
# At least 32 random bytes, different per environment: openssl rand -base64 48
JWT_SECRET=change-me
# HTTPS only. false only when the site is served over plain http.
REFRESH_COOKIE_SECURE=true

# ── Public addresses ─────────────────────────────────────────
# Web origin: invitation / password reset links and the trusted origin of refresh calls.
WEB_BASE_URL=https://txtms.tagoplus.co.kr
# Origins allowed to call the API, comma-separated. When set, it MUST include WEB_BASE_URL: the web
# server forwards the browser's Origin header with every /api call, so a list without the web origin
# refuses every POST with 403 "Invalid CORS request". The pipeline checks this.
CORS_ALLOWED_ORIGINS=https://txtms.tagoplus.co.kr

# ── Mail (SMTP) ──────────────────────────────────────────────
# Invitations, password resets, email changes and reminders. Empty MAIL_HOST = no delivery (mails stay in the outbox).
# Gmail: smtp.gmail.com, 587 (STARTTLS), the account and an app password (Google account > Security > App passwords).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender address; empty = MAIL_USERNAME (Gmail only sends as the account or a verified alias).
# MAIL_FROM=
# Demo mode (dev server) only: who may receive real mail, comma-separated "@domain" or full addresses. Others are
# kept in the outbox as "발송 안 함" (the seeded accounts use real-looking company addresses). Empty = nobody.
# Ignored when DEMO_ENABLED=false (production sends to everyone).
MAIL_ALLOWED_RECIPIENTS=

# ── Demo data (dev server only — keep false in production) ───
# true seeds the demo customers and accounts into an empty database and lets demo accounts log in.
DEMO_ENABLED=false
# Password of the demo accounts when they are first seeded.
DEMO_DEFAULT_PASSWORD=
# Temporary sign-up page (/signup) for trying every role. Only works while DEMO_ENABLED=true; default true.
# DEMO_SIGNUP_ENABLED=false

# ── Container sizing (optional) ──────────────────────────────
# API_MEM_LIMIT=1g
# WEB_MEM_LIMIT=768m
